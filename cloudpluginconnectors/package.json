{
  "name": "codebolt-cloud-plugin-connectors",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "deploy:dev": "npm run deploy --workspace=@codebolt/connectors-dev",
    "deploy:work": "npm run deploy --workspace=@codebolt/connectors-work",
    "deploy:comm": "npm run deploy --workspace=@codebolt/connectors-comm"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.79.0"
  }
}
