{
  "name": "@codebolt/mail-tool-tester",
  "version": "0.1.0",
  "description": "Static CodeBolt agent that smoke-tests every mail tool.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "codebolt",
    "mail",
    "tool-test"
  ],
  "author": "codebolt",
  "license": "MIT",
  "dependencies": {
    "@codebolt/codeboltjs": "latest",
    "@codebolt/types": "^5.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "rimraf": "^5.0.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/**/*"
  ],
  "private": true
}
