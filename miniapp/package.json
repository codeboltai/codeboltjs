{
  "name": "codebolt-miniapp-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build:leads": "nitro build examples/leads",
    "build:lead-react": "pnpm --dir examples/lead-react build",
    "build:onboarding": "nitro build examples/onboarding",
    "build:examples": "pnpm build:leads && pnpm build:lead-react && pnpm build:onboarding",
    "build:remote-node": "node scripts/build-target.mjs node",
    "build:remote-cloudflare": "node scripts/build-target.mjs cloudflare",
    "gate:build": "nitro build gates/mountable-output && node gates/mountable-output/generate-assets.mjs",
    "gate:mount": "node gates/mountable-output/verify.mjs",
    "gate:worker": "node gates/worker-transport/verify.mjs",
    "gates": "pnpm gate:build && pnpm gate:mount && pnpm gate:worker",
    "start": "node packages/host/src/cli.mjs --dir examples",
    "miniapp": "node packages/miniappmanager/src/cli.mjs",
    "sample-cloud": "node packages/sample-cloud/src/cli.mjs",
    "sample-cloud:deploy": "pnpm exec wrangler deploy -c packages/sample-cloud/wrangler.jsonc",
    "miniapp-router:deploy": "pnpm exec wrangler deploy -c packages/miniapp-router-worker/wrangler.jsonc",
    "miniapp-deploy-provider:deploy": "pnpm exec wrangler deploy -c packages/miniapp-deploy-provider-worker/wrangler.jsonc",
    "miniapp-deploy-provider:check": "node --check packages/miniapp-deploy-provider-worker/src/index.mjs",
    "test:capabilities": "node --test tests/capabilities.test.mjs",
    "test:sample-cloud": "node --test tests/sample-cloud.test.mjs",
    "test:router-worker": "node --test tests/router-worker.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:remote-cloudflare": "node --test tests/remote-cloudflare.test.mjs",
    "test:remote-node": "node --test tests/remote-node.test.mjs",
    "test": "pnpm gates && pnpm build:examples && pnpm test:capabilities && pnpm test:sample-cloud && pnpm test:router-worker && pnpm test:integration && pnpm build:remote-node && pnpm test:remote-node && pnpm build:remote-cloudflare && pnpm test:remote-cloudflare"
  },
  "devDependencies": {
    "jiti": "^2.6.1",
    "nitro": "3.0.260610-beta",
    "typescript": "^5.9.2"
  }
}
