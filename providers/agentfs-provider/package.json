{
  "name": "@codebolt/agentfs-provider",
  "version": "1.4.2",
  "description": "Mounted AgentFS copy-on-write overlay provider for CodeBolt",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "start-provider.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test:overlay": "npm run build && node test-overlay.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "codebolt",
    "agentfs",
    "overlay",
    "provider"
  ],
  "author": "CodeBolt",
  "license": "MIT",
  "dependencies": {
    "@codebolt/codeboltjs": "latest",
    "@codebolt/types": "^5.1.12",
    "agentfs-sdk": "^0.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
